{
  "name": "beangle-bashub",
  "private": true,
  "version": "0.0.8-SNAPSHOT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "node scripts/check-pnpm.cjs",
    "dev:web": "pnpm --filter @beangle/bashub-web dev",
    "build:web": "pnpm --filter @beangle/bashub-web build",
    "package": "pnpm -r run package",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "archiver": "^8.0.0"
  }
}
