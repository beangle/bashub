{
  "name": "beangle-bashub",
  "version": "0.0.8",
  "description": "The BAS console backend, written in D.",
  "authors": ["chaostone"],
  "license": "GPLv3",
  "toolchainRequirements": {
    "dub": ">=1.34.0",
    "frontend": ">=2.102.0",
    "ldc": ">=1.32.0"
  },
  "dependencies": {
    "dxml": "~>0.4.5",
    "vibe-inet": "~>1.3.0",
    "vibe-http": "~>1.5.0",
    "vibe-stream:tls": "~>1.4.0"
  },
  "subConfigurations": {
    "vibe-stream:tls": "notls"
  },
  "lflags": [
    "-L-L/usr/lib64",
    "-lpq"
  ],
  "configurations": [
    {
      "name": "executable",
      "targetType": "executable",
      "targetPath": "target/d",
      "targetName": "bashub",
      "versions": ["EventCoreSilenceLeakWarnings", "VibeDisableCommandLineParsing"]
    },
    {
      "name": "unittest",
      "targetPath": "target/d",
      "sourcePaths": ["src", "test"],
      "importPaths": ["src", "test"]
    }
  ]
}
