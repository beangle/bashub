[Unit]
Description=Beangle BAS console server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bas
Group=beangle
Environment=HOME=/var/lib/bas
WorkingDirectory=/var/lib/bas
# profile 定位到 /var/lib/bas/.ems/<profile>
ExecStart=/usr/bin/bashub --ems.home=/var/lib/bas/.ems --ems.profile=bas
Restart=on-failure
# 配置或数据库初始化失败时 exit 2，不进行无意义的重启。
RestartPreventExitStatus=2
StartLimitBurst=5
StartLimitInterval=120
StandardOutput=journal
StandardError=journal
UMask=0002

[Install]
WantedBy=multi-user.target
