    "package": "pnpm run build && node ../../scripts/zip-dist.mjs release/bashub-web.zip"
  },
  "dependencies": {
    "@beangle/bui-vue": "^0.0.5",
    "@beangle/ems-app": "^0.0.3",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "tdesign-icons-vue-next": "^0.4.11",
    "tdesign-vue-next": "^1.20.8",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.2.4",
    "vue-tsc": "^2.2.0"
  }
}
