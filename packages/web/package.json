  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "scripts": {
    "preinstall": "node ../../scripts/check-pnpm.cjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
