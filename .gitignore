*~
.*
# 例外：@beangle 作用域指向本地 registry（无密钥），需要随仓库分发
!/.npmrc

# Build output directies
target
dist
node_modules
*.zip

# D (dub)：.dub 被上面的 .* 覆盖，这里只补对象/静态库
*.o
*.a

# npm lock files are not allowed, this repo is managed by pnpm
package-lock.json
npm-shrinkwrap.json

# frontend release archives
packages/web/release/

# Eclipse specific files/directories
.classpath
.project
.settings
.metadata

*.class
*.log

#idea
*.iml
*.ipr
*.iws
